# Copy to .env and fill in.

# Public URL you open the app at. With Tailscale Serve this is https://<machine>.<tailnet>.ts.net
BASE_URL=https://homeserver.your-tailnet.ts.net
TZ_NAME=Asia/Singapore

# Todoist: Settings > Integrations > Developer > API token
TODOIST_API_TOKEN=

# Google OAuth client JSON (type "Web application"), saved inside the data folder.
GOOGLE_CLIENT_SECRETS=/srv/data/google_client_secret.json
PLANNER_CALENDAR_NAME=Planner
